{
  "name": "mirrorview",
  "version": "0.1.0",
  "description": "Cross-platform desktop webcam studio for predictable meeting previews and virtual camera feeds",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "webcam",
    "virtual-camera",
    "preview",
    "meeting",
    "teams",
    "zoom",
    "meet"
  ],
  "author": "MirrorView Lead Engineering",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
